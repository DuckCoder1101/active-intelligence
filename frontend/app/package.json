    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vercel": "^58.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"

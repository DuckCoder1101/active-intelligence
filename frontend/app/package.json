{
  "name": "guara-client-portal",
  "private": true,
  "type": "module",
  "version": "1.17.0",
  "scripts": {
    "predev": "node -e \"try{require('fs').accessSync('../shared/sync.js');require('child_process').execSync('node ../shared/sync.js .',{stdio:'inherit'})}catch(e){}\"",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "node -e \"try{require('fs').accessSync('../shared/sync.js');require('child_process').execSync('node ../shared/sync.js .',{stdio:'inherit'})}catch(e){}\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "predeploy": "node -e \"try{require('fs').accessSync('../shared/sync.js');require('child_process').execSync('node ../shared/sync.js .',{stdio:'inherit'})}catch(e){}\"",
    "deploy": "vercel deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.79.0",
    "react-icons": "^5.6.0",
    "react-imask": "^7.6.1",
    "react-toastify": "^11.1.0",
    "tailwindcss": "^4.1.18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
